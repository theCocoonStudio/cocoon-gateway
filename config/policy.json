{
  "roles": {
    "claude": { "cn": "claude" },
    "gemini": { "cn": "gemini" }
  },
  "writable": [
    "theCocoonStudio/cocoon-ai",
    "theCocoonStudio/cocoon-ai-records",
    "theCocoonStudio/cocoon-ml",
    "theCocoonStudio/cocoon-relations",
    "theCocoonStudio/cocoon-agent-sandbox",
    "theCocoonStudio/cocoon-gateway",
    "theCocoonStudio/cocoon-copula"
  ],
  "rules": [
    { "role": "claude", "upstream": "github",    "method": "GET",   "path": "^(/api/v3)?/.*" },
    { "role": "claude", "upstream": "github",    "method": "POST",  "path": "^(/api/v3)?/repos/{writable}/(pulls|issues)$" },
    { "role": "claude", "upstream": "github",    "method": "POST",  "path": "^(/api/v3)?/repos/{writable}/(pulls|issues)/[0-9]+/(reviews|comments)$" },
    { "role": "claude", "upstream": "github",    "method": "PATCH", "path": "^(/api/v3)?/repos/{writable}/pulls/[0-9]+$" },
    { "role": "claude", "upstream": "github",    "method": "PUT",   "path": "^(/api/v3)?/repos/{writable}/pulls/[0-9]+/(merge|update-branch)$" },
    { "role": "claude", "upstream": "github",    "method": "POST",  "path": "^(/api/graphql|/graphql)$" },
    { "role": "claude", "upstream": "git",       "method": "GET",   "path": "^/[^/]+/[^/]+(\\.git)?/info/refs$" },
    { "role": "claude", "upstream": "git",       "method": "POST",  "path": "^/[^/]+/[^/]+(\\.git)?/git-upload-pack$" },
    { "role": "claude", "upstream": "git",       "method": "POST",  "path": "^/{writable}(\\.git)?/git-receive-pack$" },
    { "role": "claude", "upstream": "anthropic", "method": "POST",  "path": "^/v1/messages(/count_tokens)?$" },
    { "role": "claude", "upstream": "anthropic", "method": "GET",   "path": "^/v1/models.*" },
    { "role": "claude", "upstream": "npm",          "method": "GET", "path": ".*" },
    { "role": "claude", "upstream": "npm",          "method": "POST", "path": "^/-/npm/v1/security/(advisories/bulk|audits/quick)$" },
    { "role": "claude", "upstream": "arxiv",        "method": "GET", "path": ".*" },
    { "role": "claude", "upstream": "export-arxiv", "method": "GET", "path": ".*" },
    { "role": "gemini", "upstream": "github",    "method": "GET",   "path": "^(/api/v3)?/.*" },
    { "role": "gemini", "upstream": "github",    "method": "POST",  "path": "^(/api/v3)?/repos/{writable}/(pulls|issues)$" },
    { "role": "gemini", "upstream": "github",    "method": "POST",  "path": "^(/api/v3)?/repos/{writable}/(pulls|issues)/[0-9]+/(reviews|comments)$" },
    { "role": "gemini", "upstream": "github",    "method": "PATCH", "path": "^(/api/v3)?/repos/{writable}/pulls/[0-9]+$" },
    { "role": "gemini", "upstream": "github",    "method": "POST",  "path": "^(/api/graphql|/graphql)$" },
    { "role": "gemini", "upstream": "git",       "method": "GET",   "path": "^/[^/]+/[^/]+(\\.git)?/info/refs$" },
    { "role": "gemini", "upstream": "git",       "method": "POST",  "path": "^/[^/]+/[^/]+(\\.git)?/git-upload-pack$" },
    { "role": "gemini", "upstream": "git",       "method": "POST",  "path": "^/{writable}(\\.git)?/git-receive-pack$" },
    { "role": "gemini", "upstream": "anthropic", "method": "POST",  "path": "^/v1/messages(/count_tokens)?$" },
    { "role": "gemini", "upstream": "anthropic", "method": "GET",   "path": "^/v1/models.*" },
    { "role": "gemini", "upstream": "npm",          "method": "GET", "path": ".*" },
    { "role": "gemini", "upstream": "npm",          "method": "POST", "path": "^/-/npm/v1/security/(advisories/bulk|audits/quick)$" },
    { "role": "gemini", "upstream": "arxiv",        "method": "GET", "path": ".*" },
    { "role": "gemini", "upstream": "export-arxiv", "method": "GET", "path": ".*" }
  ]
}
